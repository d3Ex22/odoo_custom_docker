{
    "private": true,
    "name": "odoo-web-terminal",
    "description": "xterm.js 6 client of the web terminal (served by server.py); npm install && npm run build regenerates public/bundle.js",
    "scripts": {
        "build": "esbuild src/client.js --bundle --outfile=public/bundle.js --format=esm --minify"
    },
    "dependencies": {
        "@xterm/xterm": "^6.0.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-webgl": "^0.19.0",
        "@xterm/addon-clipboard": "^0.2.0",
        "@xterm/addon-unicode11": "^0.9.0"
    },
    "devDependencies": {
        "esbuild": "^0.25.0"
    }
}
