                            </t>
                            <t t-else="" t-out="props.noContentHelper"/>
                        </div>
                    </div>
                    <div t-attf-class="history-comparison-view #{state.currentView === 'comparison' ? '' : 'd-none'}">
                        <div class="history-view-top-bar">
