# Odoo custom docker
# Version: 2.2

# ============================================
# ODOO RUNTIME
# ============================================
# Odoo startup arguments
ODOO_ARGS='--dev xml --limit-time-real 0'

# Modules to update on startup (comma-separated, empty = none)
ODOO_UPDATE='all'

# Selected database (empty = multi-database mode)
SELECTED_DB=main


# ============================================
# PATHS
# ============================================
# Path to addons directory (usually git repo root)
ADDONS_PATH=./addons

# Scan subfolders for addons automatically
SCAN_SUBFOLDERS=true

# Enterprise repo path (leave empty for Community Edition)
ENTERPRISE_PATH=

# Odoo repo path (used for module name completion, optionnal)
ODOO_PATH=


# ============================================
# SECRETS
# ============================================
# Enterprise subscription code (for migration)
ENTERPRISE_KEY=

# Ngrok auth token (for grok command)
NGROK_KEY=


# ============================================
# ODOO VERSION
# Change all 3 values together when switching Odoo version
# Or use ./setup.sh which resolves them automatically
#
# Version Matrix (default, min-max supported):
# ┌─────────┬──────────────────┬────────────────┐
# │ Odoo    │ Python           │ PostgreSQL     │
# ├─────────┼──────────────────┼────────────────┤
# │ 19.0    │ 3.12 (3.10-3.12) │ 17 (14-17)     │
# │ 18.0    │ 3.12 (3.10-3.12) │ 16 (12-16)     │
# │ 17.0    │ 3.11 (3.10-3.11) │ 15 (12-16)     │
# │ 16.0    │ 3.10 (3.8-3.11)  │ 15 (12-15)     │
# │ 15.0    │ 3.10 (3.8-3.10)  │ 14 (10-14)     │
# └─────────┴──────────────────┴────────────────┘
# ============================================
ODOO_VERSION=19.0
ODOO_BUILD=latest # latest or specific version
PYTHON_VERSION=3.12
POSTGRES_VERSION=17


# ============================================
# PROJECT CONFIGURATION
# ============================================
COMPOSE_PROJECT_NAME=odoo_dev

# URLs (keep .docker.localhost for local development)
ODOO_URL=odoo.docker.localhost
UTILS_URL=utils.docker.localhost
LOGS_URL=logs.docker.localhost


# ============================================
# DATABASE
# ============================================
DB_HOST=db
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=odoo