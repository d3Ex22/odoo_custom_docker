# =============================================================================
# ODOO RELATED SETTINGS
# =============================================================================

# -----------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------

# [OPTIONAL] Database to use on startup (empty = Odoo picks / multi-DB mode)
SELECTED_DB=main

# [OPTIONAL] Modules to update on startup, comma-separated (empty = none)
#   Examples: all | base | sale,purchase,stock
ODOO_UPDATE=all

# [OPTIONAL] Extra Odoo CLI arguments passed on every start
#   Examples: '--dev xml'            → hot-reload views without restart
#             '--limit-time-real 0'  → disable request timeout
#             '--log-level=debug'    → verbose logging (debug, warn, error, critical)
ODOO_ARGS=''

# -----------------------------------------------------------------------
# IOT
# -----------------------------------------------------------------------

# Enable or Disable built-in IoT Box mode (true/false, requires Odoo >= 19.0)
#   When true, installs IoT dependencies and loads iot_drivers at startup.
#   Allows the Odoo instance to act as its own IoT Box for printer/device access.
ODOO_IOT_BOX=false


# -----------------------------------------------------------------------
# ODOO VERSION STACK
# Change all three together when switching version.
# Use 'rebuild' command in utils to apply after changes.
#
# odoo : def_py : compat_py                  : def_pg : compat_pg
# 19.0 : 3.12   : 3.13,3.12,3.11,3.10        : 17     : 17,16,15,14,13
# 18.0 : 3.12   : 3.13,3.12,3.11,3.10        : 17     : 17,16,15,14,13,12
# 17.0 : 3.10   : 3.13,3.12,3.11,3.10        : 16     : 16,15,14,13,12
# 16.0 : 3.10   : 3.12,3.11,3.10,3.9,3.8,3.7 : 15     : 15,14,13,12,11,10
# 15.0 : 3.10   : 3.12,3.11,3.10,3.9,3.8,3.7 : 14     : 15,14,13,12,11,10
# 14.0 : 3.8    : 3.10,3.9,3.8,3.7,3.6       : 13     : 13,12,11,10
# -----------------------------------------------------------------------

ODOO_VERSION=19.0
PYTHON_VERSION=3.12
POSTGRES_VERSION=17

# Specific nightly build date (YYYYMMDD) or 'latest'
# See at: https://nightly.odoo.com/ODOO_VERSION/nightly/deb/ -> Replace ODOO_VERSION with your desired odoo version
ODOO_BUILD=latest

# -----------------------------------------------------------------------

# Quick guide to relative paths !!!

# Exemple structure:
# odoo/
# ├── 19.0/
# |  ├── project/
# |  |  ├── docker-compose.yml
# |  |  └── addons/
# |  |     └── custom-addons/
# |  |         └── module1/
# |  |         └── ...
# |  |     └── extra-addons/
# |  |         └── module1/
# |  |         └── ...
# |  |     └── oca-addons/
# |  |         └── module1/
# |  |         └── ...
# |  ├── odoo/
# |  |  └── ...
# |  └── enterprise/
# |     └── module1/
# |     └── ...
# └      ...

# In this exemple, /addons is the root folder of all addons in it's subfolders.
# /enterprise is a clone of the odoo repository.

# Relative path theory:
# . means the current directory (compared to docker-compose.yml -> /project)
# .. means the parent directory (compared to docker-compose.yml -> /19.0)
# ../../ means the grandparent directory (compared to docker-compose.yml -> parent of /19.0 -> /odoo)
# etc.

# Examples:
# ADDONS_PATH=./addons means the addons folder is in the current directory of the docker-compose.yml file (in /project)
# ENTERPRISE_PATH=../enterprise means the enterprise folder is in the parent directory of the docker-compose.yml file (in /19.0)
# etc.

# -----------------------------------------------------------------------
# PATHS
# Relative to docker-compose.yml
# -----------------------------------------------------------------------

# Path to your custom addons folder
# **WARNING**: Must be relative to the docker-compose.yml file.
# **WARNING**: Only one path is supported. Path to the root folder of all addons.
# **WARNING**: Is going to be scanned for subfolders to detect addon modules.
ADDONS_PATH=./addons

# [OPTIONAL] Path to Odoo Enterprise repo (leave empty for Community Edition)
# **WARNING**: Must be relative to the docker-compose.yml file.
ENTERPRISE_PATH=

# [OPTIONAL] Path to Odoo source repo (needed for some scripts)
# **WARNING**: Must be relative to the docker-compose.yml file.
ODOO_PATH=

# Scan ADDONS_PATH subfolders recursively to detect addon modules (true/false)
SCAN_SUBFOLDERS=true

# -----------------------------------------------------------------------
# SECRETS
# -----------------------------------------------------------------------

# [OPTIONAL] Odoo Enterprise subscription key (required for 'migrate' command)
ENTERPRISE_KEY=

# [OPTIONAL] Ngrok auth token (required for 'grok' command)
NGROK_KEY=


# =============================================================================
# DOCKER RELATED SETTINGS
# =============================================================================

# -----------------------------------------------------------------------
# DOCKER OPTIONS
# -----------------------------------------------------------------------

# Container restart policy: no | always | on-failure | unless-stopped
RESTART_ON_FAIL=unless-stopped

# Grace period before force-killing a container on stop (e.g. 1s, 500ms)
FORCE_STOP_DELAY=1s

# -----------------------------------------------------------------------
# PROJECT & NETWORK
# -----------------------------------------------------------------------
# Change this only if running multiple instances simultaneously.

# Prefix for all container names and the Docker network.
COMPOSE_PROJECT_NAME=odoo_dev

NETWORK_NAME=odoo_network
NETWORK_SUBNET=172.28.0.0/16

# Traefik routing hostnames (keep .docker.localhost for local dev)
ODOO_URL=odoo.docker.localhost
UTILS_URL=utils.docker.localhost
LOGS_URL=logs.docker.localhost
