# =============================================================================
# ODOO RELATED SETTINGS
# =============================================================================
# Layout (the hub's Config panel and the status daemon are generated from it):
#   # ==== / # ---- blocks            section / sub-section (title, optional description)
#   # help lines above KEY=value      one setting; contiguous keys share the help
#   #@ marker line (last help line)   optional · auto (read-only) · type=bool
#                                     apply=r (next Odoo start) | compose (docker compose up -d) | rebuild
#                                     wipe=db (the change wipes the databases)
# =============================================================================

# -----------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------

# Database to use on startup (empty = Odoo picks / multi-DB mode)
#   'db select' sets it and restarts Odoo.
#@ optional apply=r
SELECTED_DB=main

# Modules to update by 'u' / 'start' when no module is given (empty = none)
#   Examples: all | base | sale,purchase,stock
#   Set it from utils with: u -k <modules>
#@ optional apply=r
ODOO_UPDATE=

# Extra Odoo CLI arguments passed on every start
#   Examples: '--dev xml'            → hot-reload views without restart
#             '--limit-time-real 0'  → disable request timeout
#             '--log-level=debug'    → verbose logging (debug, warn, error, critical)
#@ optional apply=r
ODOO_ARGS=

# Auto-update watcher — 'watch on' / 'watch off' set this
#   When true, a utils side pane runs 'u <module>' each time a module's
#   __manifest__.py is saved under ADDONS_PATH. Reopened on 'docker compose up'.
#@ type=bool
AUTO_UPDATE=false

# -----------------------------------------------------------------------
# MAIL, WEBSOCKET & DEBUG
# -----------------------------------------------------------------------

# Outgoing mail catcher (Mailpit): every mail Odoo sends lands in
# http://<project>.mail.docker.localhost instead of leaving the machine
# (odoo.conf smtp + every ir.mail_server are pointed to it at start).
# Compose profiles — 'mail' enables the container; empty disables it.
#@ apply=compose
COMPOSE_PROFILES=mail

# Port of /websocket: 8069 in threaded mode (default), 8072 when Odoo runs
# with workers (ODOO_ARGS='--workers=2').
#@ apply=compose
ODOO_WS_PORT=8069

# Start Odoo under debugpy so that Cursor / VS Code can attach.
# 'debug on' / 'debug off' set this, restart Odoo and write .vscode/launch.json
# with the host port.
#@ type=bool apply=r
DEBUGPY=false

# Host port of debugpy: empty = a free port chosen by Docker (never conflicts
# between projects), set one to keep it fixed across restarts.
#@ optional apply=compose
DEBUGPY_PORT=

# -----------------------------------------------------------------------
# IOT
# -----------------------------------------------------------------------

# Built-in IoT Box mode (requires Odoo >= 19.0)
#   When true, installs IoT dependencies and loads iot_drivers at startup.
#   Allows the Odoo instance to act as its own IoT Box for printer/device access.
#@ type=bool apply=compose
ODOO_IOT_BOX=false

# -----------------------------------------------------------------------
# ODOO VERSION STACK
# Change them together when switching version (the hub config panel
# validates the combination against .data/compat.map), then 'rebuild'.
# -----------------------------------------------------------------------

# Odoo series and Python of the Odoo image
#@ apply=rebuild
ODOO_VERSION=19.0
PYTHON_VERSION=3.12

# PostgreSQL major
#   Changing it wipes the databases of this project: back them up first (db backup).
#@ apply=rebuild wipe=db
POSTGRES_VERSION=17

# Nightly build of the Odoo source: a date YYYYMMDD or 'latest'
#   Available builds: https://nightly.odoo.com/<ODOO_VERSION>/nightly/src/
#@ apply=rebuild
ODOO_BUILD=latest

# -----------------------------------------------------------------------
# PATHS
# All relative to this folder (the one holding docker-compose.yml):
#   .  = this folder, .. = its parent. Typical layout:
#   19.0/
#   ├── project/            ← this folder: ADDONS_PATH=./addons
#   │   └── addons/         ← one root, scanned for modules (sub-folders allowed)
#   ├── enterprise/         ← ENTERPRISE_PATH=../enterprise
#   └── odoo/               ← ODOO_PATH=../odoo
# -----------------------------------------------------------------------

# Root folder of your addons (one path; its sub-folders are scanned for modules)
#@ apply=compose
ADDONS_PATH=./addons

# Odoo Enterprise repository (empty = Community Edition)
#   Must be on the ODOO_VERSION series: Odoo refuses to start otherwise. If it is
#   a git clone, 'pull' (and every 'rebuild') checks out the right branch for you.
#@ optional apply=compose
ENTERPRISE_PATH=

# Odoo source repository: 'pull', 'upgrade-code' scripts, module autocompletion
#   Same series rule as ENTERPRISE_PATH.
#@ optional apply=compose
ODOO_PATH=

# Host ssh folder mounted read-only in utils so that 'pull' can fetch
# private repos (enterprise) over ssh. Empty = detected at start (the ~/.ssh
# of the user owning this folder, when it holds a key) and written here.
# Https remotes use GITHUB_TOKEN instead (see SECRETS).
#@ optional apply=compose
SSH_PATH=

# Scan ADDONS_PATH subfolders recursively to detect addon modules
#@ type=bool apply=r
SCAN_SUBFOLDERS=true

# Comma-separated paths excluded from SCAN_SUBFOLDERS addon detection.
#   Examples:
#   disabled                              → every folder named "disabled"
#   my_repo/disabled                      → only that path under ADDONS_PATH
#   /mnt/extra-addons/custom/disabled     → absolute path inside the container
#@ optional apply=r
IGNORED_PATH=

# -----------------------------------------------------------------------
# SECRETS
# This file is versioned: prefer putting these keys in a git-ignored
# `.env.secrets` file next to this one (same KEY=value syntax).
# -----------------------------------------------------------------------

# Odoo Enterprise subscription key (required for 'migrate' command)
#@ optional
ENTERPRISE_KEY=

# Ngrok auth token (required for 'grok' command)
#@ optional
NGROK_KEY=

# GitHub token with read access to odoo/enterprise (used by 'pull'
# for https remotes). Fine-grained token → Contents: read-only.
#@ optional
GITHUB_TOKEN=

# =============================================================================
# DOCKER RELATED SETTINGS
# =============================================================================

# -----------------------------------------------------------------------
# DOCKER OPTIONS
# -----------------------------------------------------------------------

# Container restart policy: no | always | on-failure | unless-stopped
#@ apply=compose
RESTART_ON_FAIL=unless-stopped

# Grace period before force-killing a container on stop (e.g. 1s, 500ms)
#@ apply=compose
FORCE_STOP_DELAY=1s

# Images are shared by every project (odoo-env/odoo:19.0-py3.12-latest-<rev>,
# odoo-env/db:17...). The ones not used by any project for this many days are
# removed automatically (at start, then daily). 0 keeps them all.
#@ apply=compose
IMAGE_RETENTION_DAYS=30

# Revision of the odoo / utils Dockerfiles, part of the image tags so that a
# project only runs an image built from its own Dockerfile.
# Maintained by the utils container and 'rebuild': do not edit.
#@ auto
ODOO_IMAGE_REV=604f82e9
UTILS_IMAGE_REV=bcd476b7

# Template repository this environment was copied from: 'env-update' fetches
# it and refreshes the environment files (.data/, docker-compose.yml, docs)
# of this project without touching .env values, .config/, addons/, db_files/.
# ENV_TEMPLATE_REF: branch or tag to follow (empty = the repository's default
# branch, i.e. the current release line). The hub proposes the update when the
# template's .data/VERSION is newer than this project's (checked hourly).
#@ optional
ENV_TEMPLATE_REPO=https://github.com/d3Ex22/odoo_custom_docker.git
ENV_TEMPLATE_REF=

# -----------------------------------------------------------------------
# PROJECT
# Several projects run side by side behind one shared proxy (started by the
# first project that comes up). Each project is named after its folder:
# ./19/_Shop → "shop" → containers shop_odoo / shop_utils / shop_db and
#   http://odoo.docker.localhost               hub: tabs of the running projects
#   http://shop.odoo.docker.localhost          this project's Odoo
#   http://shop.logs.docker.localhost          live logs
#   http://shop.utils.docker.localhost         utils terminal
#   http://shop.mcp.docker.localhost/mcp       MCP server for AI agents
#   http://shop.mail.docker.localhost          caught outgoing mails
# -----------------------------------------------------------------------

# Override the name (lowercase letters, digits, - or _) only when
# two project folders share the same name.
#@ optional apply=compose
COMPOSE_PROJECT_NAME=

# Colour of the project: its tab in the hub and the primary colour of its
# terminals (titles, prompt, cursor). Empty = picked from the name, another
# one when a project of this machine already has it (written here then).
# A palette name (yellow cyan red purple green orange blue fg) or #rrggbb.
#@ optional apply=compose
PROJECT_COLOR=
